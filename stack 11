#include <string>
#include <stack>

using namespace std;

class Solution {
public:
    bool isValid(string s) {
        stack<char> brackets;
        
        for (char c : s) {
            // 1. If it's an opening bracket, push it onto the stack
            if (c == '(' || c == '{' || c == '[') {
                brackets.push(c);
            } 
            // 2. If it's a closing bracket, verify compatibility with the top element
            else {
                // If stack is empty, we have a closing bracket with no opening bracket
                if (brackets.empty()) {
                    return false;
                }
                
                char top = brackets.top();
                // Check if the current closing bracket matches the most recent opening bracket
                if ((c == ')' && top == '(') || 
                    (c == '}' && top == '{') || 
                    (c == ']' && top == '[')) {
                    brackets.pop(); // Valid pair found, remove from stack
                } else {
                    return false; // Mismatched bracket types
                }
            }
        }
        
        // 3. The string is valid only if all opening brackets have been properly closed
        return brackets.empty();
    }
};
