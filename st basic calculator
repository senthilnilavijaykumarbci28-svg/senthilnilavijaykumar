class Solution {
public:
    int calculate(string s) {
        int n = s.length();
        if (n == 0) return 0;
        
        stack<int> st;
        long long currentNumber = 0;
        char sign = '+'; 
        
        for (int i = 0; i < n; i++) {
            char ch = s[i];
            
            
            if (isdigit(ch)) {
                currentNumber = currentNumber * 10 + (ch - '0');
            }
            
            
            if (!isdigit(ch) && !isspace(ch) || i == n - 1) {
                if (sign == '+') {
                    st.push(currentNumber);
                } 
                else if (sign == '-') {
                    st.push(-currentNumber);
                } 
                else if (sign == '*') {
                    int topVal = st.top(); st.pop();
                    st.push(topVal * currentNumber);
                } 
                else if (sign == '/') {
                    int topVal = st.top(); st.pop();
                    st.push(topVal / currentNumber); 
                }
                
                
                sign = ch;
                currentNumber = 0;
            }
        }
        
    
        int result = 0;
        while (!st.empty()) {
            result += st.top();
            st.pop();
        }
        
        return result;
    }
};
