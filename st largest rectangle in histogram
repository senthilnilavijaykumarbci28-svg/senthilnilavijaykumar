#include <vector>
#include <stack>
#include <algorithm>

using namespace std;

class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        stack<int> st; // Stores indices of the histogram bars
        int max_area = 0;
        
        // Add a sentinel value (0) at the end to force-flush remaining elements in the stack
        heights.push_back(0);
        int n = heights.size();
        
        for (int i = 0; i < n; i++) {
            // While the current bar is shorter than the bar at the top of our stack
            while (!st.empty() && heights[i] < heights[st.top()]) {
                int height = heights[st.top()]; // Take the height of the bar to be popped
                st.pop();
                
                // Calculate width: 
                // If the stack is empty, it means this bar was the shortest seen so far,
                // so the width extends all the way from index 0 to i.
                int width = st.empty() ? i : (i - st.top() - 1);
                
                max_area = max(max_area, height * width);
            }
            // Push the current bar's index onto the stack
            st.push(i);
        }
        
        return max_area;
    }
};
