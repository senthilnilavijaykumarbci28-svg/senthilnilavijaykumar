class Solution {
private:
    
    vector<int> maxSubsequence(const vector<int>& nums, int len) {
        vector<int> res;
        int drop = nums.size() - len; 
        
        for (int num : nums) {
            
            while (drop > 0 && !res.empty() && res.back() < num) {
                res.pop_back();
                drop--; 
            }
            res.push_back(num);
        }
        
        res.resize(len);
        return res;
    }
    
    
    bool greater(const vector<int>& v1, int i, const vector<int>& v2, int j) {
        while (i < v1.size() && j < v2.size()) {
            if (v1[i] < v2[j]) return false;
            if (v1[i] > v2[j]) return true;
            i++;
            j++;
        }
        return i < v1.size(); 
    }

    
    vector<int> merge(const vector<int>& v1, const vector<int>& v2) {
        vector<int> merged;
        int i = 0, j = 0;
        while (i < v1.size() || j < v2.size()) {
            
            if (greater(v1, i, v2, j)) {
                merged.push_back(v1[i++]);
            } else {
                merged.push_back(v2[j++]);
            }
        }
        return merged;
    }

public:
    vector<int> maxNumber(vector<int>& nums1, vector<int>& nums2, int k) {
        int m = nums1.size();
        int n = nums2.size();
        vector<int> maxResult;
        
        
        int start = max(0, k - n); 
        int end = min(k, m);     
        
        for (int x = start; x <= end; ++x) {
            vector<int> sub1 = maxSubsequence(nums1, x);
            vector<int> sub2 = maxSubsequence(nums2, k - x);
            vector<int> candidate = merge(sub1, sub2);
            
            if (maxResult.empty() || candidate > maxResult) {
                maxResult = candidate;
            }
        }
        
        return maxResult;
    }
};
