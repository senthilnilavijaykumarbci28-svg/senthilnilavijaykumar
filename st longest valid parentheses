#include <string>
#include <stack>
#include <algorithm>

using namespace std;

class Solution {
public:
    int longestValidParentheses(string s) {
        stack<int> indices;
        // Push a base boundary anchor to handle length calculations cleanly
        indices.push(-1); 
        
        int max_length = 0;
        
        for (int i = 0; i < s.length(); i++) {
            if (s[i] == '(') {
                // Store the index of the opening bracket
                indices.push(i);
            } else {
                // Pop the last opening bracket index or anchor boundary
                indices.pop();
                
                if (indices.empty()) {
                    // If empty, this ')' is unmatched. It becomes our new base anchor.
                    indices.push(i);
                } else {
                    // If not empty, we calculate the length of the current valid segment
                    max_length = max(max_length, i - indices.top());
                }
            }
        }
        
        return max_length;
    }
};
