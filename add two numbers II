class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        stack<int> s1;
        stack<int> s2;
        
        // Push all values of list 1 onto stack 1
        while (l1 != nullptr) {
            s1.push(l1->val);
            l1 = l1->next;
        }
        
        // Push all values of list 2 onto stack 2
        while (l2 != nullptr) {
            s2.push(l2->val);
            l2 = l2->next;
        }
        
        ListNode* head = nullptr;
        int carry = 0;
        
        // Process digits from least to most significant
        while (!s1.empty() || !s2.empty() || carry != 0) {
            int sum = carry;
            
            if (!s1.empty()) {
                sum += s1.top();
                s1.pop();
            }
            if (!s2.empty()) {
                sum += s2.top();
                s2.pop();
            }
            
            carry = sum / 10;
            
            // Create a new node and link it upstream (building right-to-left)
            ListNode* newNode = new ListNode(sum % 10);
            newNode->next = head;
            head = newNode;
        }
        
        return head;
    }
};
