#include <vector>
#include <unordered_map>

using namespace std;

class Solution {
public:
    vector<int> intersect(vector<int>& nums1, vector<int>& nums2) {
        unordered_map<int, int> counts;
        vector<int> result;
        
        // 1. Record element frequencies of the first array
        for (int num : nums1) {
            counts[num]++;
        }
        
        // 2. Scan the second array and collect matching instances
        for (int num : nums2) {
            // If the element exists in the map and has a remaining count
            if (counts.count(num) && counts[num] > 0) {
                result.push_back(num);
                counts[num]--; // Decrement frequency to match duplicate instances accurately
            }
        }
        
        return result;
    }
};
